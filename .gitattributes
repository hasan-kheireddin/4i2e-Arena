# Enforce LF line endings for all files on all platforms
* text=auto eol=lf

# Shell scripts must be LF
*.sh text eol=lf

# Python, JS/TS, config files
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.md text eol=lf

# Dockerfiles
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
