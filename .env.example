POSTGRES_DB=ft_transcendence
POSTGRES_USER=ft_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=5432

REDIS_PORT=6379

DJANGO_SECRET_KEY=your-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,https://host.docker.internal:8443
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443,https://host.docker.internal:8443
FRONTEND_URL=https://localhost:8443
GAME_SESSION_TTL_SECONDS=1800

OAUTH_42_CLIENT_ID=your_42_client_id
OAUTH_42_CLIENT_SECRET=your_42_client_secret
OAUTH_42_REDIRECT_URI=https://localhost/oauth/callback

HTTPS_PORT=443

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL="4i2e Arena <your_email@gmail.com>"
